# Where the app finds the AI gateway.
#
# Anything prefixed EXPO_PUBLIC_ is embedded in the app bundle and is readable by
# anyone who downloads the app — so a URL belongs here, and an API key never does.
# The Anthropic key lives on the gateway server (see server/README.md).
#
# Use your machine's LAN IP rather than localhost when running on a physical device.
EXPO_PUBLIC_AI_GATEWAY_URL=http://localhost:8787
